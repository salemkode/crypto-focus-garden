{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "jsxImportSource": "nativewind",
    "paths": {
      "react-native-webview": [
        "./node_modules/react-native-webview/lib/index.d.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "modules",
    "test",
    "tests",
    "dist",
    "ios",
    "android"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app.config.ts",
    "index.ts",
    "nativewind-env.d.ts"
  ]
}
