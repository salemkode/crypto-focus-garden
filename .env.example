# Optional public app configuration. Every EXPO_PUBLIC value is included in the app bundle.
# Leave unset for local-only sessions. Never put seeds, WIFs or RPC credentials here.

# EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your-public-walletconnect-project-id
# EXPO_PUBLIC_GARDEN_API_URL=https://your-chipnet-service.example
# EXPO_PUBLIC_GARDEN_CATEGORY=64-lowercase-hex-characters
# EXPO_PUBLIC_GARDEN_CONTRACT_BYTECODE=compiled-locking-bytecode-hex
# EXPO_PUBLIC_GARDEN_DIRECTORY_CATEGORY=64-lowercase-hex-characters
# EXPO_PUBLIC_GARDEN_DIRECTORY_BYTECODE=compiled-locking-bytecode-hex
# EXPO_PUBLIC_GARDEN_GENESIS_HASH=64-lowercase-hex-characters
# EXPO_PUBLIC_GARDEN_CHECKPOINT_HEIGHT=positive-validated-height
# EXPO_PUBLIC_GARDEN_CHECKPOINT_HASH=64-lowercase-hex-characters
# EXPO_PUBLIC_GARDEN_MIN_CONFIRMATIONS=6

# Debug only: local HTTP is restricted to loopback port 3487.
# EXPO_PUBLIC_GARDEN_API_URL=http://127.0.0.1:3487
# EXPO_PUBLIC_GARDEN_LOCAL_TEST_HTTP=1

# Optional iOS Family Controls entitlement/extension; requires signing approval.
# FOCUS_SHIELD_IOS=1

# Optional development diagnostics, disabled unless explicitly set.
# EXPO_PUBLIC_VALLEY_STATS=1
