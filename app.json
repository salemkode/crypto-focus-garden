{
  "expo": {
    "name": "Focus Garden Next",
    "slug": "focus-garden-next",
    "scheme": "focusgardennext",
    "version": "1.0.0",
    "icon": "./assets/focus-garden-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.arquebus.focusgarden.next",
      "supportsTablet": false,
      "entitlements": {
        "application-identifier": "$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)",
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)"
        ]
      }
    },
    "android": {
      "package": "com.arquebus.focusgarden.next",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#EEF3F0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to protect access to your Focus Garden wallet backup."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/focus-garden-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#EEF3F0"
        }
      ]
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/focus-garden-icon.png"
    }
  }
}
