{
	"name": "@focus-garden/root",
	"private": true,
	"version": "0.0.1",
	"workspaces": [
		"packages/*"
	],
	"license": "MIT",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"compile": "bun run --filter='*' compile",
		"dev": "bun run mobile:start",
		"build": "bun run --filter='*' compile",
		"test": "bun run test:contracts && bun run test:mobile && bun run test:service",
		"clean": "rm -rf packages/**/dist",
		"mobile:start": "cd packages/mobile && bun run start",
		"mobile:ios": "cd packages/mobile && bun run ios",
		"mobile:android": "cd packages/mobile && bun run android",
		"mobile:export": "cd packages/mobile && bun run export:check",
		"typecheck:mobile": "cd packages/mobile && bun run typecheck",
		"lint:mobile": "cd packages/mobile && bun run lint",
		"test:mobile": "cd packages/mobile && bun run test",
		"test:contracts": "cd packages/contracts && bun run test:pomodoro",
		"test:native-core": "cd packages/mobile/modules/libauth-native && bun run test:host",
		"check": "bun run typecheck:mobile && bun run typecheck:service && bun run lint:mobile && bun run --cwd packages/mobile check:valley && bun run test",
		"test:service": "cd packages/service && bun run test",
		"typecheck:service": "cd packages/service && bun run typecheck",
		"service:start": "cd packages/service && bun run start",
		"contracts:deploy": "cd packages/contracts && bun run deploy",
		"landing:dev": "cd packages/landing && bun run dev",
		"landing:build": "cd packages/landing && bun run build"
	},
	"dependencies": {
		"@bch-wc2/interfaces": "^0.0.16",
		"@bch-wc2/mainnet-js-signer": "^0.0.16",
		"@bitauth/libauth": "^3.0.0",
		"cashscript": "^0.13.0-next.1",
		"mainnet-js": "^2.7.31"
	},
	"devDependencies": {
		"@types/node": "^24.10.1"
	},
	"patchedDependencies": {
		"react-native-worklets-core@1.6.3": "patches/react-native-worklets-core@1.6.3.patch",
		"react-native-filament@1.11.0": "patches/react-native-filament@1.11.0.patch",
		"react-native-screens@4.30.1": "patches/react-native-screens@4.30.1.patch"
	}
}
