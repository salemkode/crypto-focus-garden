pragma cashscript ^0.13.0;
// v3: version | owner script (25) | plantedAt (4) | 512-second units (1).
// Dates are metadata; elapsed time is enforced independently by consensus.
contract PomodoroRewards(bytes32 categoryId) {
    function mintAndLockReward(int plantedAt, int units, bytes20 rewardPkh) {
        require(this.activeInputIndex == 0);
        require(units == 3 || units == 6);
        // Unsigned 32-bit seconds; bytes4() alone would reject values from 2^31 (January 2038).
        require(plantedAt >= 500000000 && plantedAt <= 4294967295);
        require(tx.inputs[0].tokenCategory == categoryId + 0x02);
        require(tx.inputs[0].nftCommitment == 0x);
        require(tx.inputs[0].tokenAmount == 0);
        require(tx.outputs.length >= 2);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == 0x);
        require(tx.outputs[0].tokenAmount == 0);
        require(tx.outputs[0].value == tx.inputs[0].value);
        require(tx.inputs[1].tokenCategory == 0x);
        // Funding input is a P2PKH wallet. The web dapp may send the reward to that same wallet;
        // the separate-owner rule is enforced by Focus Forest v5, which supersedes this contract.
        bytes funder = tx.inputs[1].lockingBytecode;
        require(funder.length == 25);
        require(funder.split(3)[0] == 0x76a914);
        require(funder.split(23)[1] == 0x88ac);
        bytes owner = new LockingBytecodeP2PKH(rewardPkh);
        require(owner.length == 25);
        require(owner.split(3)[0] == 0x76a914);
        require(owner.split(23)[1] == 0x88ac);
        require(tx.outputs[1].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[1].tokenCategory == categoryId + 0x01);
        require(tx.outputs[1].tokenAmount == 0);
        require(tx.outputs[1].value >= 1000);
        require(tx.outputs[1].nftCommitment == 0x03 + owner + bytes5(plantedAt).split(4)[0] + bytes1(units));
        if (tx.outputs.length > 2) {
            int o = 2;
            do {
                require(tx.outputs[o].tokenCategory == 0x);
                require(tx.outputs[o].lockingBytecode != tx.inputs[0].lockingBytecode);
                o = o + 1;
            } while (o < tx.outputs.length);
        }
    }
    function claimReward() {
        require(this.activeInputIndex == 0);
        require(tx.inputs[0].tokenCategory == categoryId + 0x01);
        require(tx.inputs[0].tokenAmount == 0);
        bytes commitment = tx.inputs[0].nftCommitment;
        require(commitment.length == 31);
        require(commitment.split(1)[0] == 0x03);
        bytes owner = commitment.split(1)[1].split(25)[0];
        int units = int(commitment.split(30)[1]);
        require(units == 3 || units == 6);
        // BIP68 time flag; consensus measures age from confirmation using MTP.
        require(this.age >= 4194304 + units);
        require(tx.outputs[0].lockingBytecode == owner);
        require(tx.outputs[0].tokenCategory == categoryId);
        require(tx.outputs[0].tokenAmount == 0);
        require(tx.outputs[0].nftCommitment == commitment);
        require(tx.outputs[0].value == tx.inputs[0].value);
        if (tx.outputs.length > 1) {
            int o = 1;
            do {
                require(tx.outputs[o].tokenCategory == 0x);
                o = o + 1;
            } while (o < tx.outputs.length);
        }
    }
}
