pragma cashscript ^0.13.0;
// Focus Forest v5. Every tree NFT stays in this contract until its owner claims it.
// Commitment (39 bytes):
//   0x05 | owner pkh (20) | planter tag (12) | stamp (4) | 512-second units (1) | look (1)
// look = tier * 16 + species.
//   Tiers by verified focus lock: 1 Sprout (>= 1 unit, 8.5 min), 2 Tree (>= 3 units, 25.6 min),
//   3 Big Tree (>= 6 units, 51.2 min), 4 House (>= 11 units, 93.9 min).
//   Species 1..6 (oak, cherry, pine, maple, birch, cash) are the planter's chosen style.
// Merges keep the value: 3 Sprouts -> Tree, 2 Trees -> Big Tree, 2 Big Trees -> House.
// planter tag = first 12 bytes of hash160(app wallet locking bytecode); only that wallet may merge.
// stamp = planting time for planted trees, or a lineage fingerprint of the burned trees for merges.
contract FocusForest(bytes32 categoryId) {
    function plantTree(int plantedAt, int units, int tier, int species, bytes20 ownerPkh) {
        require(this.activeInputIndex == 0);
        require(units >= 1 && units <= 24);
        require(species >= 1 && species <= 6);
        require(tier >= 1 && tier <= 4);
        // Every tier needs its own minimum focus lock.
        if (tier == 4) { require(units >= 11); }
        else if (tier == 3) { require(units >= 6); }
        else if (tier == 2) { require(units >= 3); }
        require(plantedAt >= 500000000);
        require(tx.inputs[0].tokenCategory == categoryId + 0x02);
        require(tx.inputs[0].nftCommitment == 0x);
        require(tx.inputs[0].tokenAmount == 0);
        require(tx.outputs.length >= 2);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == 0x);
        require(tx.outputs[0].tokenAmount == 0);
        require(tx.outputs[0].value == tx.inputs[0].value);
        require(tx.inputs[1].tokenCategory == 0x);
        // No other input may come from this contract, so no tree can be burned here.
        int p = 1;
        do {
            require(tx.inputs[p].lockingBytecode != tx.inputs[0].lockingBytecode);
            p = p + 1;
        } while (p < tx.inputs.length);
        bytes planter = tx.inputs[1].lockingBytecode;
        require(planter.length == 25);
        require(planter.split(3)[0] == 0x76a914);
        require(planter.split(23)[1] == 0x88ac);
        // Rewards belong to a separate owner, never the paying app wallet.
        require(planter.split(3)[1].split(20)[0] != ownerPkh);
        bytes tag = hash160(planter).split(12)[0];
        require(tx.outputs[1].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[1].tokenCategory == categoryId + 0x01);
        require(tx.outputs[1].tokenAmount == 0);
        require(tx.outputs[1].value >= 1000);
        require(tx.outputs[1].nftCommitment == 0x05 + ownerPkh + tag + bytes4(plantedAt) + bytes1(units) + bytes1(tier * 16 + species));
        if (tx.outputs.length > 2) {
            int o = 2;
            do {
                require(tx.outputs[o].tokenCategory == 0x);
                require(tx.outputs[o].lockingBytecode != tx.inputs[0].lockingBytecode);
                o = o + 1;
            } while (o < tx.outputs.length);
        }
    }

    // Every tree input runs this function and proves its own lock has matured.
    // Input 0 also checks the ingredients, the planter's signing input and the result.
    function mergeTrees() {
        bytes self = tx.inputs[this.activeInputIndex].lockingBytecode;
        bytes own = tx.inputs[this.activeInputIndex].nftCommitment;
        require(own.length == 39);
        int ownUnits = int(own.split(37)[1].split(1)[0]);
        require(this.age >= 4194304 + ownUnits);
        // Input 0 must be a tree running this same merge (plant and claim forbid extra contract inputs).
        require(tx.inputs[0].lockingBytecode == self);
        require(tx.inputs[0].tokenCategory == categoryId + 0x01);
        require(tx.inputs[0].nftCommitment.length == 39);
        require(this.activeInputIndex < tx.inputs.length - 1);
        require(tx.outputs.length >= 2);
        if (this.activeInputIndex == 0) {
            bytes head = own.split(33)[0];
            require(head.split(1)[0] == 0x05);
            bytes tag = head.split(21)[1];
            int look = int(own.split(38)[1]);
            int tier = look / 16;
            require(tier >= 1 && tier <= 3);
            int count = 2;
            if (tier == 1) { count = 3; }
            require(tx.inputs.length == count + 1);
            bytes lineage = 0x;
            int i = 0;
            do {
                bytes entry = tx.inputs[i].nftCommitment;
                require(tx.inputs[i].lockingBytecode == self);
                require(tx.inputs[i].tokenCategory == categoryId + 0x01);
                require(tx.inputs[i].tokenAmount == 0);
                require(entry.length == 39);
                // Same owner, same planting wallet and same tier for every ingredient.
                require(entry.split(33)[0] == head);
                require(int(entry.split(38)[1]) / 16 == tier);
                lineage = lineage + entry;
                i = i + 1;
            } while (i < count);
            // The app wallet that planted the trees must sign its funding input.
            bytes planter = tx.inputs[count].lockingBytecode;
            require(tx.inputs[count].tokenCategory == 0x);
            require(planter.length == 25);
            require(planter.split(3)[0] == 0x76a914);
            require(planter.split(23)[1] == 0x88ac);
            require(hash160(planter).split(12)[0] == tag);
            bytes stamp = hash256(lineage).split(4)[0];
            int result = (tier + 1) * 16 + look % 16;
            require(tx.outputs[0].lockingBytecode == self);
            require(tx.outputs[0].tokenCategory == categoryId + 0x01);
            require(tx.outputs[0].tokenAmount == 0);
            require(tx.outputs[0].value >= 1000);
            require(tx.outputs[0].nftCommitment == head + stamp + 0x00 + bytes1(result));
            int o = 1;
            do {
                require(tx.outputs[o].tokenCategory == 0x);
                require(tx.outputs[o].lockingBytecode != self);
                o = o + 1;
            } while (o < tx.outputs.length);
        }
    }

    function claimTree() {
        require(this.activeInputIndex == 0);
        require(tx.inputs[0].tokenCategory == categoryId + 0x01);
        require(tx.inputs[0].tokenAmount == 0);
        bytes self = tx.inputs[0].lockingBytecode;
        int c = 1;
        do {
            require(tx.inputs[c].lockingBytecode != self);
            c = c + 1;
        } while (c < tx.inputs.length);
        bytes commitment = tx.inputs[0].nftCommitment;
        require(commitment.length == 39);
        require(commitment.split(1)[0] == 0x05);
        bytes20 ownerPkh = bytes20(commitment.split(1)[1].split(20)[0]);
        int units = int(commitment.split(37)[1].split(1)[0]);
        // BIP68 time flag; consensus measures age from confirmation using MTP.
        require(this.age >= 4194304 + units);
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(ownerPkh));
        require(tx.outputs[0].tokenCategory == categoryId);
        require(tx.outputs[0].tokenAmount == 0);
        require(tx.outputs[0].nftCommitment == commitment);
        require(tx.outputs[0].value == tx.inputs[0].value);
        if (tx.outputs.length > 1) {
            int o = 1;
            do {
                require(tx.outputs[o].tokenCategory == 0x);
                o = o + 1;
            } while (o < tx.outputs.length);
        }
    }
}
