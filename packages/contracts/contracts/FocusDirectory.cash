pragma cashscript ^0.13.0;
// Focus Directory. Anyone can mint their own profile card: a mutable NFT held by their
// app wallet, so every Focus Garden member is discoverable by name and can be tipped
// without anyone typing an address.
// Profile commitment: 0x01 | display name (3..32 bytes UTF-8).
// The holder may later edit the card themselves (mutable capability). An optional
// "about me" text rides in an OP_RETURN output of the registration transaction.
contract FocusDirectory(bytes32 categoryId) {
    function register(bytes20 holderPkh, bytes name) {
        require(this.activeInputIndex == 0);
        require(name.length >= 3 && name.length <= 32);
        require(tx.inputs[0].tokenCategory == categoryId + 0x02);
        require(tx.inputs[0].nftCommitment == 0x);
        require(tx.inputs[0].tokenAmount == 0);
        require(tx.outputs.length >= 2);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory);
        require(tx.outputs[0].nftCommitment == 0x);
        require(tx.outputs[0].tokenAmount == 0);
        require(tx.outputs[0].value == tx.inputs[0].value);
        // The registrant pays from, and signs with, the wallet that will hold the card.
        bytes holder = new LockingBytecodeP2PKH(holderPkh);
        require(tx.inputs[1].lockingBytecode == holder);
        require(tx.inputs[1].tokenCategory == 0x);
        int i = 1;
        do {
            require(tx.inputs[i].lockingBytecode != tx.inputs[0].lockingBytecode);
            i = i + 1;
        } while (i < tx.inputs.length);
        require(tx.outputs[1].lockingBytecode == holder);
        require(tx.outputs[1].tokenCategory == categoryId + 0x01);
        require(tx.outputs[1].tokenAmount == 0);
        require(tx.outputs[1].value >= 1000);
        require(tx.outputs[1].nftCommitment == 0x01 + name);
        if (tx.outputs.length > 2) {
            int o = 2;
            do {
                require(tx.outputs[o].tokenCategory == 0x);
                o = o + 1;
            } while (o < tx.outputs.length);
        }
    }
}
