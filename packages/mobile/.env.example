# Public deployment configuration only; never put a key/token here.
EXPO_PUBLIC_GARDEN_NETWORK=chipnet
EXPO_PUBLIC_GARDEN_API_URL=https://your-garden-service.example
EXPO_PUBLIC_GARDEN_CATEGORY=
# P2SH32 locking bytecode from the independently verified Focus Forest deployment:
EXPO_PUBLIC_GARDEN_CONTRACT_BYTECODE=
EXPO_PUBLIC_GARDEN_DIRECTORY_CATEGORY=
EXPO_PUBLIC_GARDEN_DIRECTORY_BYTECODE=
# Match the operator's independently verified checkpoint and categories for the selected network.
# For an isolated Mainnet build, replace the Chipnet checkpoint values below.
EXPO_PUBLIC_GARDEN_GENESIS_HASH=
EXPO_PUBLIC_GARDEN_CHECKPOINT_HEIGHT=115252
EXPO_PUBLIC_GARDEN_CHECKPOINT_HASH=00000000040ba9641ba98a37b2e5ceead38e4e2930ac8f145c8094f94c708727
EXPO_PUBLIC_GARDEN_MIN_CONFIRMATIONS=6
# Optional ONLY for an owned Android debug acceptance session with adb reverse
# tcp:3487 tcp:3487. Set API_URL=http://127.0.0.1:3487 and this flag to1.
# Release builds refuse HTTP even with the flag set. Never expose it on a LAN.
EXPO_PUBLIC_GARDEN_LOCAL_TEST_HTTP=0
# Valley renderer on iOS/Android: filament (default, native up to 120 Hz) or webview (three.js). The web always uses three.js.
EXPO_PUBLIC_VALLEY_RENDERER=
