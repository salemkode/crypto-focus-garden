# Public configuration only; never put a key here.
# There is no Focus Garden server: the app talks to Bitcoin Cash through public Electrum servers.
# Network whose deployment record (packages/contracts/deployments/<network>.json) this build uses.
EXPO_PUBLIC_FOCUS_NETWORK=mainnet
# Optional: pin one Electrum (Fulcrum, WSS) server hostname instead of the public list.
EXPO_PUBLIC_ELECTRUM_SERVER=
# Valley renderer on iOS/Android: filament (default, native up to 120 Hz) or webview (three.js). The web always uses three.js.
EXPO_PUBLIC_VALLEY_RENDERER=
