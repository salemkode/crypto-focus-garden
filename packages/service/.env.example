# No real secrets or deployment pins are committed.
GARDEN_DATABASE=/var/lib/focus-garden/garden.sqlite
GARDEN_NETWORK=chipnet
GARDEN_CATEGORY=
# Operator-owned BCHN Chipnet node, txindex=1, prune=0, assumevalid=0.
GARDEN_NODE_RPC_URL=http://127.0.0.1:48332
# Mode 0600 file containing rpcuser:rpcpassword (one line).
GARDEN_NODE_CREDENTIAL_FILE=/etc/focus-garden/node.credential
# Official BCHN v29.2.0 post-fork checkpoint, shared coordinator agreement.
# Genesis still must be verified against the owner-measured endpoint contract.
GARDEN_NODE_GENESIS_HASH=
GARDEN_NODE_CHECKPOINT_HEIGHT=115252
GARDEN_NODE_CHECKPOINT_HASH=00000000040ba9641ba98a37b2e5ceead38e4e2930ac8f145c8094f94c708727
GARDEN_MIN_CONFIRMATIONS=6
GARDEN_MAX_TIP_AGE_SECONDS=21600
# Optional mode 0600 dedicated test-identity JSON from testnet:setup (treasury role).
# GARDEN_TREASURY_KEY_FILE=/etc/focus-garden/treasury.credential
GARDEN_TREASURY_BUDGET_SATS=0
GARDEN_TREASURY_DAILY_SATS=0
PORT=3487
# Separate owner-scoped bounded test-write route; never elevate indexer read RPC.
# It must expose getblockhash for independent genesis/fork identity checks as well
# as testmempoolaccept and sendrawtransaction, for dedicated test coins only.
# GARDEN_TEST_WRITE_RPC_URL=https://operator-test-write-route.example
# GARDEN_TEST_WRITE_CREDENTIAL_FILE=/etc/focus-garden/test-write.credential

# Mainnet pilot: use a separate database and operator-owned Mainnet node.
# Start once with the empty database before provisioning Mainnet accounts.
# Set both category fields and the node pins for the published Mainnet deployment.
# Keep both treasury budgets at zero and leave the treasury key unset.
# GARDEN_NETWORK=mainnet
# GARDEN_ENABLE_MAINNET=1
# GARDEN_DIRECTORY_CATEGORY=
# Leave both writer fields unset for read-only operation.
# GARDEN_MAINNET_WRITE_RPC_URL=https://operator-mainnet-write-route.example
# GARDEN_MAINNET_WRITE_CREDENTIAL_FILE=/etc/focus-garden/mainnet-write.credential
