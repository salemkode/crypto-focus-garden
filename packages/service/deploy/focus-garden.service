[Unit]
Description=Focus Garden Chipnet service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=focusgarden
Group=focusgarden
WorkingDirectory=/opt/focus-garden/packages/service
EnvironmentFile=/etc/focus-garden/service.env
ExecStart=/usr/local/bin/bun src/main.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/focus-garden
StateDirectory=focus-garden
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
