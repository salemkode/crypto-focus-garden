# Operator-owned BCHN validating Chipnet node. Operator verifies checkpoint.
chipnet=1
server=1
txindex=1
prune=0
assumevalid=0
rest=0
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
# Generate rpcauth using BCHN's supported utility. Never commit real credentials.
# rpcauth=focusgarden:SALT$HASH
rpcwhitelistdefault=1
rpcwhitelist=focusgarden_read:getblockchaininfo,getblockhash,getblockheader,getrawtransaction,gettxout
rpcwhitelist=focusgarden_test_write:getblockhash,testmempoolaccept,sendrawtransaction
