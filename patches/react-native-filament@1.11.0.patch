+// Float32Array / ArrayBuffer <> Float32Span, read in place: valid only during the native call.
+// (Added for TransformManager.setTransforms, so a frame's matrices cross JSI as one buffer.)
+struct Float32Span {
+  const float* data = nullptr;
+  size_t size = 0;
+};
+template <> struct JSIConverter<Float32Span> {
+  static Float32Span fromJSI(jsi::Runtime& runtime, const jsi::Value& arg) {
+    jsi::Object object = arg.asObject(runtime);
+    if (object.isArrayBuffer(runtime)) {
+      jsi::ArrayBuffer buffer = object.getArrayBuffer(runtime);
+      return {reinterpret_cast<const float*>(buffer.data(runtime)), buffer.size(runtime) / sizeof(float)};
+    }
+    size_t offset = static_cast<size_t>(object.getProperty(runtime, "byteOffset").asNumber());
+    size_t length = static_cast<size_t>(object.getProperty(runtime, "byteLength").asNumber());
+    jsi::ArrayBuffer buffer = object.getProperty(runtime, "buffer").asObject(runtime).getArrayBuffer(runtime);
+    if (offset % sizeof(float) != 0 || offset + length > buffer.size(runtime)) {
+      throw std::invalid_argument("Float32Span: misaligned or out-of-range typed array");
+    }
+    return {reinterpret_cast<const float*>(buffer.data(runtime) + offset), length / sizeof(float)};
+  }
+  static jsi::Value toJSI(jsi::Runtime&, const Float32Span&) {
+    throw std::runtime_error("Float32Span cannot be returned to JavaScript");
+  }
+};
