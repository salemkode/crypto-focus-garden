+void TransformManagerImpl::setTransforms(const std::vector<Entity>& entities, const float* matrices, size_t count) {
+  if (count < entities.size() * 16) {
+    throw std::invalid_argument("setTransforms: expected " + std::to_string(entities.size() * 16) + " floats, got " + std::to_string(count));
+  }
+  std::unique_lock lock(_mutex);
+  TransformManager& transformManager = _engine->getTransformManager();
+  transformManager.openLocalTransformTransaction();
+  for (size_t i = 0; i < entities.size(); i++) {
+    TransformManager::Instance instance = transformManager.getInstance(entities[i]);
+    if (!instance.isValid()) continue;
+    const float* m = matrices + i * 16;
+    math::mat4f mat(math::float4(m[0], m[1], m[2], m[3]), math::float4(m[4], m[5], m[6], m[7]), math::float4(m[8], m[9], m[10], m[11]),
+                    math::float4(m[12], m[13], m[14], m[15]));
+    transformManager.setTransform(instance, mat);
+  }
+  transformManager.commitLocalTransformTransaction();
+}
